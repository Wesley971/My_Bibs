{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@expo/vector-icons": [
        "./node_modules/expo/node_modules/@expo/vector-icons"
      ],
      "@expo/vector-icons/*": [
        "./node_modules/expo/node_modules/@expo/vector-icons/*"
      ]
    }
  }
}

